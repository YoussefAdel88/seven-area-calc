  "validation_rules": [
    {
      "id": "gfa_equals_gla_plus_foh_boh",
      "rule": "D39 (GFA) = D32 (GLA) + D33 (FOH) + D34 (BOH) + D35 (ISA) + D38 (Shared Walls)",
      "description": "GFA must equal sum of all occupiable areas",
      "source": "SEVEN_PDF_§4.3.7"
    },
    {
      "id": "bua_equals_gfa_plus_services",
      "rule": "D45 (BUA) = D39 (GFA) + D40 (CPA) + D41-D42 (ESA) + D43 (Roof Slabs) + D44 (Basement)",
      "description": "BUA must equal GFA + all non-occupiable built areas",
      "source": "SEVEN_PDF_§4.3.12"
    },
    {
      "id": "pc_calculation",
      "rule": "D6 (PC %) = (D5 / D12) * 100",
      "description": "Plot Coverage = Building Footprint / Plot Area",
      "source": "SEVEN_PDF_§4.3.3"
    },
    {
      "id": "far_calculation",
      "rule": "FAR = D39 (GFA) / D12 (PA)",
      "description": "Floor Area Ratio = GFA / Plot Area",
      "source": "SEVEN_PDF_§4.3.8"
    }
  ]
